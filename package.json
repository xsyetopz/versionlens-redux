{
  "name": "@versionlens/workspace",
  "private": true,
  "version": "0.6.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "bun scripts/package/extension.mjs",
    "version:bump": "bun scripts/release/version.mjs",
    "marketplaces:configure": "bun scripts/release/configure-marketplaces.mjs",
    "biome:check": "biome check --write --unsafe --max-diagnostics 16384",
    "biome:format": "biome format --write --max-diagnostics 16384",
    "biome:lint": "biome lint --write --max-diagnostics 16384",
    "verify": "bun run check:biome && bun run check:rustfmt && bun run check:manifests && bun run test:release && bun run check:clippy && bun run typecheck && bun run check:extension-build && cargo test --workspace --locked && bun run test:extension && bun run package:editors",
    "check:biome": "biome check --max-diagnostics 16384",
    "check:clippy": "cargo clippy --workspace --all-targets",
    "check:extension-build": "bun scripts/package/extension.mjs --check",
    "check:rustfmt": "cargo fmt --all -- --check",
    "check:manifests": "bun scripts/generate/manifests.mjs --check",
    "generate:manifests": "bun scripts/generate/manifests.mjs",
    "package": "bun scripts/package/vscode.mjs",
    "package:vscode-target": "bun scripts/package/vscode.mjs",
    "package:editors": "bun scripts/package/editors.mjs",
    "test": "bun run test:extension",
    "test:extension": "bun scripts/test/extension.mjs",
    "test:e2e": "cargo build -p versionlens-lsp && bun run build && bun scripts/test/e2e.mjs",
    "test:release": "bun test scripts/release",
    "typecheck": "bun check --cwd packages/vscode-extension"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/vscode": "1.145.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "4.1.0",
    "lefthook": "2.2.2"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@vscode/vsce-sign",
    "keytar"
  ],
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.3"
  }
}
