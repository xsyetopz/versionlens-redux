{
	"name": "@versionlens/workspace",
	"version": "0.6.3",
	"private": true,
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"@types/bun": "1.4.4",
			"@types/node": "26.6.6",
			"eslint-plugin-jsdoc": "65.4.5",
			"markdownlint-cli2": "0.24.0",
			"markdownlint-rule-title-case-style": "0.4.3",
			"oxlint": "1.93.0",
			"oxlint-tsgolint": "7.0.2006",
			"typescript": "7.0.2",
			"typescript-bedrock": "0.1.7"
		}
	},
	"scripts": {
		"build": "bun scripts/package/extension.mjs",
		"check:clippy": "cargo clippy --workspace --all-targets",
		"check:extension-build": "bun scripts/package/extension.mjs --check",
		"check:manifests": "bun scripts/generate/manifests.mjs --check",
		"check:rustfmt": "cargo fmt --all -- --check",
		"format": "bun fmt",
		"format:check": "bun fmt --check",
		"generate:manifests": "bun scripts/generate/manifests.mjs",
		"guard": "typescript-bedrock guard",
		"lint": "bun run --sequential --no-exit-on-error oxlint markdownlint-cli2",
		"lint:fix": "bun run --sequential --no-exit-on-error 'oxlint --fix' 'markdownlint-cli2 --fix'",
		"marketplaces:configure": "bun scripts/release/configure-marketplaces.mjs",
		"package": "bun scripts/package/vscode.mjs",
		"package:editors": "bun scripts/package/editors.mjs",
		"package:vscode-target": "bun scripts/package/vscode.mjs",
		"test": "bun run test:extension",
		"test:e2e": "cargo build -p versionlens-lsp && bun run build && bun scripts/test/e2e.mjs",
		"test:extension": "bun scripts/test/extension.mjs",
		"test:release": "bun test scripts/release",
		"typecheck": "bun check",
		"verify": "bun run --sequential format:check typecheck lint guard test",
		"version:bump": "bun scripts/release/version.mjs"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@types/vscode": "1.145.0",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "4.1.0",
		"eslint-plugin-jsdoc": "catalog:",
		"markdownlint-cli2": "catalog:",
		"markdownlint-rule-title-case-style": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"typescript-bedrock": "catalog:"
	},
	"overrides": {
		"@types/node": "26.6.6"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"packageManager": "bun@1.4.4",
	"trustedDependencies": [
		"@vscode/vsce-sign",
		"keytar"
	]
}
